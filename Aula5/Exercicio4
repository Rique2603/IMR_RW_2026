import math


def calcular_orientacao_alvo(x, y, theta, x_alvo, y_alvo, Kp=1.5):
	angulo_alvo = math.atan2(y_alvo - y, x_alvo - x)
	erro = (angulo_alvo - theta + math.pi) % (2 * math.pi) - math.pi
	return Kp * erro


if __name__ == "__main__":
	print(calcular_orientacao_alvo(0.0, 0.0, 0.0, 1.0, 1.0))
